<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smvdu.mess.controllers.ForgotPasswordController"
            styleClass="login-bg"
            prefHeight="700" prefWidth="900">

    <!-- Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 20; -fx-background-color: white;">
            <Button text="← Back to Login" onAction="#goBack" 
                    style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 8 15; -fx-cursor: hand;"/>
            
            <ImageView fitWidth="45" preserveRatio="true">
                <image>
                    <Image url="@/images/smvdu.png"/>
                </image>
            </ImageView>
            
            <Label text="SMVDU Mess Billing System" 
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e3a5f;"/>
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 30;">
            
            <VBox alignment="CENTER" spacing="10" maxWidth="450" 
                  style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                
                <Label text="🔐 Reset Password" 
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e3a5f;"/>
                
                <Label text="Enter your registered email to receive OTP" 
                       style="-fx-font-size: 13px; -fx-text-fill: #666; -fx-padding: 0 0 20 0;"/>
                
                <!-- Email Section -->
                <VBox spacing="8" style="-fx-padding: 0 0 10 0;">
                    <Label text="Email Address:" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                    <TextField fx:id="emailField" promptText="your.email@smvdu.ac.in" 
                               prefWidth="350" style="-fx-font-size: 14px; -fx-padding: 10;"/>
                </VBox>
                
                <Button fx:id="sendOTPButton" text="Send OTP" onAction="#handleSendOTP" 
                        prefWidth="350" 
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12; -fx-cursor: hand;"/>
                
                <Label fx:id="statusLabel" text="" 
                       style="-fx-font-size: 12px; -fx-text-fill: #2196F3; -fx-padding: 5 0;"/>
                
                <Separator prefWidth="350" style="-fx-padding: 10 0;"/>
                
                <!-- OTP Verification Section (Initially Hidden) -->
                <VBox fx:id="otpSection" spacing="12" style="-fx-padding: 10 0 0 0;">
                    
                    <Label text="Enter OTP and New Password" 
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                    
                    <VBox spacing="5">
                        <Label text="OTP (6 digits):" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                        <TextField fx:id="otpField" promptText="123456" 
                                   prefWidth="350" style="-fx-font-size: 14px; -fx-padding: 10;"/>
                    </VBox>
                    
                    <VBox spacing="5">
                        <Label text="New Password:" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                        <PasswordField fx:id="newPasswordField" promptText="Minimum 6 characters" 
                                       prefWidth="350" style="-fx-font-size: 14px; -fx-padding: 10;"/>
                    </VBox>
                    
                    <VBox spacing="5">
                        <Label text="Confirm Password:" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="Re-enter password" 
                                       prefWidth="350" style="-fx-font-size: 14px; -fx-padding: 10;"/>
                    </VBox>
                    
                    <Button fx:id="resetPasswordButton" text="Reset Password" onAction="#handleResetPassword" 
                            prefWidth="350" 
                            style="-fx-background-color: #FF6F00; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12; -fx-cursor: hand;"/>
                    
                    <Hyperlink text="Didn't receive OTP? Resend" onAction="#handleResendOTP" 
                               style="-fx-font-size: 12px; -fx-text-fill: #2196F3;"/>
                </VBox>
                
            </VBox>
            
            <!-- Instructions -->
            <VBox alignment="CENTER" spacing="8" maxWidth="450" 
                  style="-fx-background-color: #E3F2FD; -fx-padding: 20; -fx-background-radius: 8;">
                <Label text="ℹ️ Instructions" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
                <Label text="• OTP is valid for 5 minutes only" style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
                <Label text="• Check your spam folder if you don't see the email" style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
                <Label text="• Password must be at least 6 characters" style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
            </VBox>
            
        </VBox>
    </center>

</BorderPane>